{
  "name": "agentmon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:app": "turbo run build --filter=@agentmon/usagent",
    "dev:app": "turbo run dev --filter=@agentmon/usagent",
    "build:land": "turbo run build --filter=@agentmon/usagent-land",
    "dev:land": "turbo run dev --filter=@agentmon/usagent-land",
    "tauri": "pnpm --filter @agentmon/usagent tauri"
  },
  "devDependencies": {
    "turbo": "^2"
  }
}
